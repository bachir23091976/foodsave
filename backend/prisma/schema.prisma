generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  MERCHANT
  ADMIN
}

enum MerchantType {
  RESTAURANT
  GROCERY
  SUPERMARKET
  BAKERY
  CAFE
  HOTEL
  OTHER
}

enum DietaryTag {
  VEGETARIAN
  VEGAN
  HALAL
  GLUTEN_FREE
  DAIRY_FREE
  NUT_FREE
}

model User {
  id                 String       @id @default(uuid())
  email              String       @unique
  password           String
  firstName          String
  lastName           String
  role               Role         @default(CLIENT)
  dietaryPreferences DietaryTag[]
 referralCode       String?      @unique
  referredById       String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  merchant       Merchant?
  orders         Order[]
  notifications  Notification[]
  savedLocations SavedLocation[]
  favorites      Favorite[]
  loyaltyRewards LoyaltyReward[]

  referredBy User?  @relation("Referrals", fields: [referredById], references: [id])
  referrals  User[] @relation("Referrals")
}

model Merchant {
  id              String       @id @default(uuid())
  name            String
  type            MerchantType @default(RESTAURANT)
  description     String?
  address         String
  city            String
  province        String
  postalCode      String
  phone           String?
  latitude        Float?
  longitude       Float?
  isApproved      Boolean      @default(false)
  stripeAccountId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String @unique

  offers    Offer[]
  favoredBy Favorite[]
}

model Offer {
  id              String       @id @default(uuid())
  title           String
  description     String?
  category        String       @default("AUTRE")
  imageUrl        String?
  originalPrice   Float
  discountedPrice Float
  quantity        Int
  pickupStart     DateTime
  pickupEnd       DateTime
  dietaryTags     DietaryTag[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  merchant   Merchant @relation(fields: [merchantId], references: [id])
  merchantId String

  orders Order[]
}

model Order {
  id              String      @id @default(uuid())
  status          OrderStatus @default(PENDING)
  totalPrice      Float
  pickupCode      String      @unique @default(uuid())
  stripeSessionId String?     @unique
  cancellationReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String

  offer   Offer  @relation(fields: [offerId], references: [id])
  offerId String
}

model Notification {
  id        String   @id @default(uuid())
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String
}

model SavedLocation {
  id        String   @id @default(uuid())
  label     String
  address   String
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String
}

model Favorite {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  merchant   Merchant @relation(fields: [merchantId], references: [id])
  merchantId String

  @@unique([userId, merchantId])
}

model LoyaltyReward {
  id          String   @id @default(uuid())
  code        String   @unique @default(uuid())
  discountCad Float
  isUsed      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String
}

enum OrderStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum SoldOutRefundStatus {
  NOT_REQUESTED
  UNKNOWN
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELED
  NEEDS_REVIEW
}

model SoldOutResolution {
  stripeSessionId      String              @id
  paymentIntentId      String?
  refundId             String?             @unique
  refundStatus         SoldOutRefundStatus @default(NOT_REQUESTED)
  refundFirstAttemptAt DateTime?
  recoveryOwnerToken   String?
  lastError            String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  manualSettlement SoldOutManualSettlement?

  @@index([refundStatus, updatedAt])
}

enum ManualSettlementMethod {
  BANK_TRANSFER
  PAYMENT_PROVIDER
}

model SoldOutManualSettlement {
  stripeSessionId   String                 @id
  operatorId        String
  completedAt       DateTime
  recordedAt        DateTime               @default(now())
  method            ManualSettlementMethod
  evidenceReference String
  paymentIntentId   String
  amountMinor       BigInt
  currency          String                 @db.VarChar(3)
  reason            String

  resolution SoldOutResolution @relation(fields: [stripeSessionId], references: [stripeSessionId], onDelete: Restrict, onUpdate: Restrict, map: "SoldOutManualSettlement_resolution_fkey")

  @@unique([method, evidenceReference])
}
